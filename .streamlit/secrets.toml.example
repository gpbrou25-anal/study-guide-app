# Copy this file to .streamlit/secrets.toml (same folder name, drop ".example")
# and fill in your real values. secrets.toml itself is gitignored — it never
# gets pushed to GitHub, and is separately pasted into Streamlit Cloud's own
# Secrets manager when you deploy (Settings -> Secrets, in the same TOML format).

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# From neon.tech's project dashboard. Include this locally too if you want
# your local runs to share the same persistent database as the deployed app.
DATABASE_URL = "postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"
